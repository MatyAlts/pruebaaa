{
  "name": "saluteca-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "mobile"
  ],
  "overrides": {
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:mobile-backend": "node --test --test-concurrency=1 tests/mobile-backend/*.test.ts",
    "mobile:lint": "npm --workspace misaluteca-ios run lint",
    "mobile:typecheck": "npm --workspace misaluteca-ios run typecheck",
    "mobile:test": "npm --workspace misaluteca-ios run test",
    "mobile:test:scripts": "npm --workspace misaluteca-ios run test:scripts",
    "mobile:export:ios": "npm --workspace misaluteca-ios run export:ios",
    "mobile:doctor": "npm --workspace misaluteca-ios exec expo-doctor",
    "mobile:install:check": "npm --workspace misaluteca-ios exec -- expo install --check"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "busboy": "^1.6.0",
    "file-type": "^21.3.0",
    "framer-motion": "^12.30.0",
    "html2canvas": "^1.4.1",
    "jpeg-js": "^0.4.4",
    "mammoth": "^1.11.0",
    "moment": "^2.30.1",
    "mysql2": "^3.16.2",
    "next": "16.1.1",
    "next-auth": "^4.24.13",
    "openai": "^6.17.0",
    "pdfjs-dist": "^5.4.624",
    "pngjs": "^7.0.0",
    "react": "19.2.3",
    "react-bootstrap": "^2.10.10",
    "react-dom": "19.2.3",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@types/busboy": "^1.5.4",
    "@types/pngjs": "^6.0.5"
  }
}
